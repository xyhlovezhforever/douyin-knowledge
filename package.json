{
  "name": "video-insight-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,connector,crawler -c cyan,green,magenta,yellow \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\" \"tsx watch connector/index.ts\" \"uv run --directory integrations/MediaCrawler uvicorn api.main:app --host 127.0.0.1 --port 8901\"",
    "setup:integrations": "powershell -ExecutionPolicy Bypass -File scripts/setup-integrations.ps1",
    "connector": "tsx connector/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/lib/comments.test.ts server/platform.test.ts server/adapters/wechatChannels.test.ts",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.7",
    "@phosphor-icons/react": "^2.1.10",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "youtubei.js": "^15.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
