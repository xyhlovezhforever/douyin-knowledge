PORT=8787
CONNECTOR_PORT=8902
MEDIACRAWLER_API_URL=http://127.0.0.1:8901/api

# Optional normalized connector endpoints. Each endpoint receives
# POST { "url": "...", "platform": "..." } and returns the VideoReport shape documented in README.md.
# WeChat Channels has a built in public metadata fallback when VIDEO_FETCH_CONNECTOR_URL is empty or unavailable.
MEDIACRAWLER_CONNECTOR_URL=http://127.0.0.1:8902/mediacrawler/analyze
VIDEO_FETCH_CONNECTOR_URL=http://127.0.0.1:8902/video-fetch/analyze

# Optional bearer tokens for self hosted connectors.
MEDIACRAWLER_CONNECTOR_TOKEN=
VIDEO_FETCH_CONNECTOR_TOKEN=
